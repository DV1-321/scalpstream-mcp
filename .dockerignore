# Keep the build context to what actually compiles. Beyond build speed this is a
# safety property: whatever is not sent cannot be baked into a layer by mistake.
.git
.github
assets
*.md
LICENSE
server.json
Dockerfile
.dockerignore
# Gallery packaging: a Gemini CLI extension, a Claude Code plugin, an Agent
# Skill. None of it compiles into the binary.
gemini-extension.json
.claude-plugin
skills

# Never ship a local environment file into an image, even though none is tracked
# here — the whole point is that this failure mode stays impossible.
.env
.env.*
*.pem
*.key
